{
  "$schema": "../../athar-console/node_modules/wrangler/config-schema.json",
  "name": "athar-restaurant-api",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  // مغلق: العناوين المعتمدة على athar.date وحدها.
  //
  // عنوان workers.dev يبقى بابًا ثانيًا للخدمة نفسها: يُفهرس، ويُنسخ في
  // رسالة لعميل، ثم يُعطَّل يومًا فيظهر العطل عند من حفظه لا عندنا. وقد
  // وقع هذا فعلًا — واجهة الصيدلية كانت تناديه فسقط الدخول كله.
  "workers_dev": false,

  // لوحة المطعم تُخدم من نفس الأصل مثل المحركين الآخرين: لا CORS.
  //
  // `run_worker_first: true` بدل قائمة مسارات: على نطاق المطعم
  // (`adana.athar.date`) الجذر هو موقع الزبون لا اللوحة، والقائمة تُقرَّر
  // بالمسار وحده فلا تفرّق بين مضيف ومضيف. الـWorker يقرأ `Host` ثم يعيد
  // ما هو ساكن إلى `env.ASSETS` بنفسه.
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // كل نطاق فرعي مطعمٌ. `console.athar.date` أخصّ فتسبقه قاعدة لوحة أثر،
  // وكلاودفلير يختار الأخصّ عند التعارض.
  "routes": [
    { "pattern": "*.athar.date/*", "zone_name": "athar.date" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-db",
      "database_id": "14685e7f-b0fe-4803-808f-2e463d0394ea"
    }
  ],

  // الصور والخطوط. الخطوط في R2 لا في حزمة الـWorker: ملفان بنحو 480KB
  // يقاربان حدّ الحجم، وتحميلهما مرة والاحتفاظ بهما في العزلة أرخص.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "athar-restaurant-assets"
    }
  ],

  "vars": {
    // حُذف الاحتياطي `PUBLIC_APP_URL` الذي كان يشير إلى workers.dev:    // `PUBLIC_SITE_DOMAIN` أدناه هو المسار الحيّ، والاحتياطي لا يُبلَغ إلا إن    // سقط — وعندها كان يعطي رابطًا ميتًا يبدو سليمًا حتى يُنقر. غيابه يعطي    // رابطًا فارغًا يُرى فورًا.
    // وجود هذه القيمة هو ما يفعّل نطاق كل مطعم. إفراغها يعيد كل شيء إلى
    // `/r/{slug}/` بلا تعديل شيفرة — مخرج إن ساء شيء في النطاق.
    "PUBLIC_SITE_DOMAIN": "athar.date"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
